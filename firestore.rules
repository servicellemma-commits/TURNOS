rules_version = '2';
// Reglas de seguridad de la base de datos.
// Se copian en Firebase → Firestore Database → Reglas → Publicar.
// Reemplazá emmatissera674@gmail.com por tu mail de administrador (el mismo de js/firebase-config.js).

service cloud.firestore {
  match /databases/{database}/documents {

    function logueado() { return request.auth != null; }
    function mail() { return request.auth.token.email; }
    function admin() {
      return logueado() && request.auth.token.email_verified == true
        && mail() in ['emmatissera674@gmail.com'];
    }
    function duenio(slug) {
      return logueado() && request.auth.token.email_verified == true
        && mail() in get(/databases/$(database)/documents/profesionales/$(slug)).data.owners;
    }
    function fechaValida(f) { return f is string && f.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function horaValida(h) { return h is string && h.matches('^[0-9]{2}:[0-9]{2}$'); }

    // Página de cada profesional: la ve cualquiera (es la cartilla pública)
    match /profesionales/{slug} {
      allow read: if true;
      allow create, delete: if admin();
      // El profesional cambia su configuración, pero no puede cambiar quiénes son los dueños
      allow update: if admin() || (duenio(slug) && request.resource.data.owners == resource.data.owners);

      // Horarios tomados: solo fecha y hora, sin datos de nadie
      match /ocupados/{id} {
        allow read: if true;
        allow create: if logueado()
          && request.resource.data.keys().hasOnly(['fecha', 'hora', 'turnoId'])
          && fechaValida(request.resource.data.fecha) && horaValida(request.resource.data.hora)
          && id == request.resource.data.fecha + '_' + request.resource.data.hora.replace(':', '')
          && existsAfter(/databases/$(database)/documents/profesionales/$(slug)/turnos/$(request.resource.data.turnoId));
        allow delete: if duenio(slug)
          || (logueado() && get(/databases/$(database)/documents/profesionales/$(slug)/turnos/$(resource.data.turnoId)).data.uid == request.auth.uid);
        allow update: if false;
      }

      // Turnos con datos del paciente: solo los ve el profesional y la familia que lo sacó
      match /turnos/{id} {
        allow read: if duenio(slug) || (logueado() && resource.data.uid == request.auth.uid);
        allow create: if duenio(slug) || (
          logueado()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.estado == 'activo'
          && request.resource.data.origen == 'web'
          && fechaValida(request.resource.data.fecha) && horaValida(request.resource.data.hora)
          && existsAfter(/databases/$(database)/documents/profesionales/$(slug)/ocupados/$(request.resource.data.fecha + '_' + request.resource.data.hora.replace(':', '')))
        );
        // La familia solo puede cancelar su propio turno
        allow update: if duenio(slug) || (
          logueado() && resource.data.uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado'])
          && request.resource.data.estado == 'cancelado'
        );
        allow delete: if duenio(slug);
      }

      // Fichas (n.º de afiliado, notas): solo el profesional
      match /pacientes/{id} {
        allow read, write: if duenio(slug);
      }
    }

    // Datos guardados de cada familia: solo esa familia, desde su celular
    match /familias/{uid} {
      allow read, write: if logueado() && request.auth.uid == uid;
    }
  }
}
